# none = quality-only (works without ML weights)
# owlv2 = experimental zero-shot detection, requires torch + transformers, large first download
# yolo = uses YOUR marine-trained weights
# yoloworld = pretrained YOLO-World (install ultralytics; initial downloads)
MODEL_MODE=none
YOLO_WEIGHTS=models/marine_best.pt
CONFIDENCE_THRESHOLD=0.22
CORS_ORIGINS=*

# Optional local Ollama explanations (only when a detection model is active)
# pip/install Ollama separately and: ollama pull llama3.2:3b
LLM_MODE=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
